# ============================================
# 🎭 MAR PD Bot - Example Environment File
# ============================================
# Copy this file to .env and fill in your values

# 🔐 TELEGRAM BOT (Get from @BotFather)
BOT_TOKEN=your_bot_token_here
BOT_OWNER_ID=your_telegram_id_here
BOT_NAME=MAR PD Bot
BOT_USERNAME=@your_bot_username
BOT_VERSION=7.0.0

# 🔥 FIREBASE (Create project at firebase.google.com)
FIREBASE_API_KEY=your_firebase_api_key
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_DB_URL=https://your-project.firebaseio.com
FIREBASE_STORAGE_BUCKET=your-project.appspot.com

# 💰 MANUAL PAYMENT (Bangladesh)
BKASH_NUMBER=017XXXXXXXX
NAGAD_NUMBER=017XXXXXXXX
PAYMENT_ADMIN_ID=admin_telegram_id

# 🎮 GAMING SYSTEM
POINTS_PER_MESSAGE=1
POINTS_PER_MEDIA=3
POINTS_PER_VOICE=5
DAILY_BONUS=10
REFERRAL_BONUS=50
GAME_COOLDOWN=30
MAX_GAMES_PER_DAY=20

# 💸 ECONOMY SYSTEM
MIN_WITHDRAW=100
MAX_WITHDRAW=5000
WITHDRAW_FEE=0.2
RECHARGE_RATE=10

# 🤖 AI LEARNING
AI_LEARNING_ENABLED=True
MIN_LEARN_LENGTH=3
MAX_LEARN_LENGTH=100
AI_RESPONSE_LIMIT=1000

# ⚙️ SYSTEM SETTINGS
DEBUG_MODE=False
LOG_LEVEL=INFO
RATE_LIMIT=50
MAX_FILE_SIZE=50

# 📁 PATHS
DATA_DIR=data
LOG_DIR=logs
BACKUP_DIR=backups

# 🔔 NOTIFICATIONS
NOTIFY_ON_START=True
NOTIFY_ON_ERROR=True
NOTIFY_OWNER=True

# 🌐 WEB DASHBOARD (Optional)
WEB_DASHBOARD=False
DASHBOARD_PORT=8080
DASHBOARD_PASSWORD=admin123

# 💾 BACKUP SYSTEM
AUTO_BACKUP=True
BACKUP_INTERVAL=3600
MAX_BACKUPS=30

# 🌍 LOCALIZATION
DEFAULT_LANGUAGE=bn
TIMEZONE=Asia/Dhaka

# 🔒 SECURITY
ENABLE_CAPTCHA=True
ALLOWED_FILE_TYPES=jpg,png,gif,mp4,pdf,docx