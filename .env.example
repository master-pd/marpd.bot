# ============================================
# 🎭 MAR PD Bot - Environment Configuration
# ============================================
# Copy this file to .env and fill in your credentials
# NEVER SHARE YOUR .env FILE PUBLICLY!

# 🔐 TELEGRAM BOT TOKENS
# ------------------------
# Get token from @BotFather on Telegram
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# Your Telegram User ID (get from @userinfobot)
BOT_OWNER_ID=YOUR_TELEGRAM_USER_ID_HERE

# 🔥 FIREBASE CONFIGURATION (Optional)
# ------------------------
# Create project at https://firebase.google.com
FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY_HERE
PROJECT_ID=YOUR_FIREBASE_PROJECT_ID_HERE
FIREBASE_DB_URL=https://YOUR_PROJECT_ID.firebaseio.com
FIREBASE_STORAGE_BUCKET=YOUR_PROJECT_ID.appspot.com

# ⚙️ BOT SETTINGS
# ------------------------
BOT_NAME=MAR PD Bot
BOT_VERSION=3.0.0

# 🤖 AI LEARNING SETTINGS
# ------------------------
AI_LEARN_ENABLED=True
LEARN_FROM_GROUPS=True
MIN_LEARN_LENGTH=3
MAX_LEARN_LENGTH=200

# 🎮 GAMING POINTS SYSTEM
# ------------------------
POINTS_MESSAGE=1
POINTS_MEDIA=3
POINTS_VOICE=5
POINTS_GAME_WIN=10
POINTS_DAILY_LOGIN=5

# 📊 LOGGING SETTINGS
# ------------------------
LOG_LEVEL=INFO
LOG_FILE=logs/marpd_bot.log

# 🔒 SECURITY SETTINGS
# ------------------------
MAX_MESSAGES_PER_MINUTE=30
ALLOWED_FILE_TYPES=jpg,jpeg,png,gif,mp4,mp3,pdf
MAX_FILE_SIZE_MB=50

# 🌐 EXTERNAL API KEYS (Optional)
# ------------------------
# OpenWeatherMap API (https://openweathermap.org/api)
WEATHER_API_KEY=

# Google API (for additional features)
GOOGLE_API_KEY=

# OpenAI API (for advanced AI)
OPENAI_API_KEY=

# 📡 WEBHOOK SETTINGS (Optional - for production)
# ------------------------
# Set if using webhook instead of polling
WEBHOOK_URL=https://yourdomain.com
WEBHOOK_PORT=8443

# 💾 DATABASE SETTINGS
# ------------------------
DB_AUTO_BACKUP=True
DB_BACKUP_INTERVAL=3600

# 🚀 PERFORMANCE SETTINGS
# ------------------------
CACHE_ENABLED=True
CACHE_TTL=300
MAX_WORKERS=10

# 🔔 NOTIFICATION SETTINGS
# ------------------------
NOTIFY_OWNER=True
NOTIFY_ON_ERROR=True
NOTIFY_ON_START=True

# 🎨 THEME & CUSTOMIZATION
# ------------------------
THEME_PRIMARY=🎭
THEME_SECONDARY=🃏
THEME_COLOR=#FF6B35

# 🇧🇩 LANGUAGE SETTINGS
# ------------------------
DEFAULT_LANGUAGE=bn
SUPPORTED_LANGUAGES=bn,en

# 📁 FILE PATHS
# ------------------------
DATA_DIR=data
LOG_DIR=logs
BACKUP_DIR=backups

# 🔧 DEBUG SETTINGS
# ------------------------
DEBUG_MODE=False
VERBOSE_LOGGING=False

# ============================================
# 🚨 IMPORTANT INSTRUCTIONS
# ============================================
# 1. Copy this file and rename to .env
# 2. Fill in your actual tokens/keys
# 3. Never commit .env to version control
# 4. Add .env to .gitignore
# 
# 🔧 Setup Steps:
# 1. Get Bot Token from @BotFather
# 2. Get your User ID from @userinfobot
# 3. (Optional) Setup Firebase project
# 4. Run: pip install -r requirements.txt
# 5. Run: python bot.py
# 
# 📞 Support: Your contact info here
# ============================================